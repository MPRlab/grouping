#!/usr/bin/env python

import argparse
import os
from datetime import datetime

import matplotlib.pyplot as plt
import numpy as np
import tensorflow as tf


class BiDirectionalRNN:
    def __init__(self):
        num_features = 314
        self.num_hidden_1 = 25

        # time steps are left open, so one model handles any clip length
        forwards_x = tf.keras.Input(shape=(None, num_features), name="forwards_x")
        backwards_x = tf.keras.layers.Lambda(lambda t: tf.reverse(t, axis=[1]), name="backwards_x")(forwards_x)
        x = tf.keras.layers.Concatenate(axis=2, name="concat")([forwards_x, backwards_x])

        lstm1 = tf.keras.layers.Bidirectional(
            tf.keras.layers.LSTM(self.num_hidden_1, activation="tanh", return_sequences=True), merge_mode="concat",
            name="lstm1")(x)

        # one weight matrix shared by every time step
        init = tf.keras.initializers.TruncatedNormal(stddev=1.0)
        self.fc = tf.keras.layers.Dense(2, kernel_initializer=init, bias_initializer=init, name="fc")
        z1 = self.fc(lstm1)

        self.model = tf.keras.Model(forwards_x, z1, name="rhythmic_grouping_rnn")
        self.optimizer = tf.keras.optimizers.Adam(0.001, epsilon=1e-8)

    @staticmethod
    def stack_labels(labels_single):
        # (start of group, not start of group) for each time step
        return tf.stack((labels_single, 1 - labels_single), 2, name="stack")

    def forward(self, forwards_x, labels_single, training=False):
        z1 = self.model(forwards_x, training=training)
        y_hat = tf.nn.softmax(z1, name="y_hat")
        loss_raw = tf.nn.softmax_cross_entropy_with_logits(labels=self.stack_labels(labels_single), logits=z1)
        loss_per_sample = tf.reduce_sum(loss_raw, axis=1, name="loss_per_sample")
        loss = tf.reduce_mean(loss_per_sample, name="loss")
        return y_hat, loss_per_sample, loss

    @tf.function
    def train_step(self, forwards_x, labels_single):
        with tf.GradientTape() as tape:
            y_hat, _, loss = self.forward(forwards_x, labels_single, training=True)
        grads = tape.gradient(loss, self.model.trainable_variables)
        self.optimizer.apply_gradients(zip(grads, self.model.trainable_variables))
        return y_hat, loss, grads

    def checkpoint(self):
        return tf.train.Checkpoint(model=self.model, optimizer=self.optimizer)

    def write_summaries(self, forwards_x, labels_single, loss, grads, step):
        backwards_x = forwards_x[:, ::-1, :]
        image_summary("forwards input", np.transpose(forwards_x[..., None], (0, 2, 1, 3)), step, max_outputs=2)
        image_summary("backwards input", np.transpose(backwards_x[..., None], (0, 2, 1, 3)), step, max_outputs=2)
        image_summary("concatenated input",
                      np.transpose(np.concatenate((forwards_x, backwards_x), axis=2)[..., None], (0, 2, 1, 3)),
                      step, max_outputs=2)
        image_summary("labels", labels_single[None, :, :, None], step, max_outputs=10)
        tf.summary.histogram("fc/w1", self.fc.kernel, step=step)
        for grad, var in zip(grads, self.model.trainable_variables):
            tf.summary.histogram(variable_name(var) + "/gradient", grad, step=step)
        tf.summary.scalar("loss", loss, step=step)


def image_summary(name, images, step, max_outputs):
    # TF1 rescaled float images to the full range; tf.summary.image in TF2 clips to [0, 1] instead
    images = np.asarray(images, dtype=np.float32)
    lo = images.min(axis=(1, 2, 3), keepdims=True)
    hi = images.max(axis=(1, 2, 3), keepdims=True)
    tf.summary.image(name, (images - lo) / np.maximum(hi - lo, 1e-12), step=step, max_outputs=max_outputs)


def variable_name(var):
    return getattr(var, "path", var.name)


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers()

    train_subparser = subparsers.add_parser("train")
    train_subparser.add_argument("dataset", help="dataset (npz file)")
    train_subparser.add_argument("--log", "-l", action="store_true", help="dataset (npz file)")
    train_subparser.add_argument("--epocs", "-e", type=int, help="number of epocs to train for", default=100)
    train_subparser.set_defaults(func=train)

    test_subparser = subparsers.add_parser("test")
    test_subparser.add_argument("dataset", help="dataset (npz file)")
    test_subparser.add_argument("checkpoint", help="checkpoint of saved weights (ckpt file)")
    test_subparser.add_argument("--test-only", "-t", action="store_true", help="just load the existing graph and test")
    test_subparser.set_defaults(func=test)

    model_only_subparser = subparsers.add_parser("model_only")
    model_only_subparser.add_argument("--time_steps", type=int, help="number of time steps")
    model_only_subparser.add_argument("--num_samples", type=int, help="number of audio samples to use (1-15 right now")
    model_only_subparser.set_defaults(func=model_only)

    args = parser.parse_args()

    if args == argparse.Namespace():
        parser.print_usage()
    else:
        args.func(args)


def common(args):
    dataset = np.load(args.dataset)
    x = dataset["x"]
    labels = dataset["labels"]
    sample_names = dataset["sample_names"]

    # make_dataset_v2 stores x as (clips, frames, features, 1); the LSTM wants (clips, frames, features)
    if x.ndim == 4:
        x = x[..., 0]

    return x.astype(np.float32), labels.astype(np.float32), sample_names


def model_only(args):
    time_steps = args.time_steps or 800
    num_samples = args.num_samples or 82
    m = BiDirectionalRNN()
    m.model.summary()
    print(m.model.compute_output_shape((num_samples, time_steps, 314)))


def train(args):
    summary_frequency = 25
    num_samples = 82

    x, labels, sample_names = common(args)
    time_steps = x.shape[1]

    m = BiDirectionalRNN()
    ckpt = m.checkpoint()

    writer = None
    log_dir = None
    if args.log:
        stamp = "{:%B_%d_%H-%M-%S}".format(datetime.now())
        log_dir = os.path.join("log_data", stamp)
        writer = tf.summary.create_file_writer(log_dir)

    fixed_length_x = x[:num_samples, 0:time_steps, :]
    fixed_length_labels = labels[:num_samples, 0:time_steps]
    y_hat = None

    try:
        for j in range(args.epocs):
            y_hat, loss, grads = m.train_step(fixed_length_x, fixed_length_labels)
            step = int(m.optimizer.iterations.numpy())
            if j % summary_frequency == 0:
                if args.log:
                    with writer.as_default():
                        m.write_summaries(fixed_length_x, fixed_length_labels, loss, grads, step)

                print(j, float(loss))

    except KeyboardInterrupt:
        pass

    if y_hat is not None:
        plot(y_hat.numpy(), fixed_length_labels, sample_names[0], sample_idx=0)

    if args.log:
        ckpt.write(os.path.join(log_dir, "rhythmic_grouping_rnn.ckpt"))
        writer.flush()


def test(args):
    num_samples = 15

    x_test, labels_test, sample_names = common(args)
    time_steps = x_test.shape[1]

    m = BiDirectionalRNN()
    m.checkpoint().read(args.checkpoint).expect_partial()

    fixed_length_x = x_test[:num_samples, 0:time_steps, :]
    fixed_length_labels = labels_test[:num_samples, 0:time_steps]
    y_hat, loss_per_sample, _ = m.forward(fixed_length_x, fixed_length_labels)
    y_hat, loss_per_sample = y_hat.numpy(), loss_per_sample.numpy()

    for test_idx in range(len(fixed_length_x)):
        print("Test Loss", loss_per_sample[test_idx])
        plt.figure()
        plt.plot(y_hat[test_idx, :, 0], label="y_hat")
        plt.plot(fixed_length_labels[test_idx], label="labels")
        plt.ylabel("% likelihood of start of group")
        plt.xlabel("time")
        plt.title("Test on sample {} ({})".format(test_idx, sample_names[test_idx]))

    plt.show()


def plot(y_hat, fixed_length_labels, sample_name, sample_idx):
    plt.plot(y_hat[sample_idx, :, 0], label="y_hat")
    plt.plot(fixed_length_labels[sample_idx], label="labels")
    plt.ylabel("% likelihood of start of group")
    plt.xlabel("time")
    plt.title("Test on sample " + sample_name)
    plt.show()


if __name__ == "__main__":
    main()
