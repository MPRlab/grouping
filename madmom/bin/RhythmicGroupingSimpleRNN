#!/usr/bin/env python

import argparse
import os
from datetime import datetime

import matplotlib.pyplot as plt
import numpy as np
import tensorflow as tf


class RNN:
    def __init__(self):
        num_features = 314
        self.time_steps = 300
        n_hidden = 512

        x = tf.keras.Input(shape=(self.time_steps, num_features, 1), name="x")
        # one feature vector per time step for the LSTM
        x_steps = tf.keras.layers.Reshape((self.time_steps, num_features))(x)
        h = tf.keras.layers.LSTM(n_hidden, return_sequences=True, name="lstm")(x_steps)

        # V and c: one output per time step, shared across time
        init = tf.keras.initializers.TruncatedNormal(stddev=1.0)
        o = tf.keras.layers.Dense(1, kernel_initializer=init, bias_initializer=init, name="output")(h)
        o = tf.keras.layers.Reshape((self.time_steps,))(o)

        self.model = tf.keras.Model(x, o, name="rhythmic_grouping_simple_rnn")
        self.optimizer = tf.keras.optimizers.Adam(learning_rate=0.001, epsilon=1e-8)

    def forward(self, x, y, training=False):
        o = self.model(x, training=training)
        y_hat = tf.nn.softmax(logits=o, name='softmax')
        loss = tf.reduce_mean(tf.nn.softmax_cross_entropy_with_logits(logits=o, labels=y))
        return y_hat, loss

    @tf.function
    def train_step(self, x, y):
        with tf.GradientTape() as tape:
            y_hat, loss = self.forward(x, y, training=True)
        grads = tape.gradient(loss, self.model.trainable_variables)
        self.optimizer.apply_gradients(zip(grads, self.model.trainable_variables))
        return y_hat, loss, grads

    def checkpoint(self):
        return tf.train.Checkpoint(model=self.model, optimizer=self.optimizer)

    def write_summaries(self, x, y, y_hat, loss, grads, step):
        image_summary("spectrogram", np.transpose(x, (0, 2, 1, 3)), step, max_outputs=3)
        tf.summary.histogram("y", y, step=step)
        tf.summary.histogram("y_hat", y_hat, step=step)
        for grad, var in zip(grads, self.model.trainable_variables):
            tf.summary.histogram(variable_name(var) + "/gradient", grad, step=step)
        tf.summary.scalar("loss", loss, step=step)


def image_summary(name, images, step, max_outputs):
    # TF1 rescaled float images to the full range; tf.summary.image in TF2 clips to [0, 1] instead
    images = np.asarray(images, dtype=np.float32)
    lo = images.min(axis=(1, 2, 3), keepdims=True)
    hi = images.max(axis=(1, 2, 3), keepdims=True)
    tf.summary.image(name, (images - lo) / np.maximum(hi - lo, 1e-12), step=step, max_outputs=max_outputs)


def variable_name(var):
    return getattr(var, "path", var.name)


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers()

    train_subparser = subparsers.add_parser("train")
    train_subparser.add_argument("dataset", help="dataset (npz file)")
    train_subparser.add_argument("--log", "-l", action="store_true", help="dataset (npz file)")
    train_subparser.add_argument("--epocs", "-e", type=int, help="number of epocs to train for", default=100)
    train_subparser.set_defaults(func=train)

    test_subparser = subparsers.add_parser("test")
    test_subparser.add_argument("dataset", help="dataset (npz file)")
    test_subparser.add_argument("checkpoint", help="checkpoint of saved weights (ckpt file)")
    test_subparser.add_argument("--test-only", "-t", action="store_true", help="just load the existing graph and test")
    test_subparser.set_defaults(func=test)

    model_only_subparser = subparsers.add_parser("model_only")
    model_only_subparser.add_argument("--time_steps", type=int, help="number of time steps")
    model_only_subparser.add_argument("--num_samples", type=int, help="number of audio samples to use (1-15 right now")
    model_only_subparser.set_defaults(func=model_only)

    args = parser.parse_args()

    if args == argparse.Namespace():
        parser.print_usage()
    else:
        args.func(args)


def common(args):
    dataset = np.load(args.dataset)
    x = dataset["x"]
    labels = dataset["labels"]
    sample_names = dataset["sample_names"]

    return x.astype(np.float32), labels.astype(np.float32), sample_names


def model_only(args):
    m = RNN()
    m.model.summary()


def train(args):
    summary_frequency = 5
    num_samples = 82
    time_steps = 300

    x, labels, sample_names = common(args)

    m = RNN()
    ckpt = m.checkpoint()

    writer = None
    log_dir = None
    if args.log:
        stamp = "{:%B_%d_%H-%M-%S}".format(datetime.now())
        log_dir = os.path.join("log_data", stamp)
        writer = tf.summary.create_file_writer(log_dir)

    np.random.seed(0)

    try:
        print("Training for {} epocs".format(args.epocs))
        for j in range(args.epocs):
            start = np.random.randint(0, x.shape[1] - time_steps)
            fixed_length_x = x[:num_samples, start:start+time_steps, :]
            fixed_length_labels = labels[:num_samples, start:start+time_steps]
            y_hat, loss, grads = m.train_step(fixed_length_x, fixed_length_labels)
            step = int(m.optimizer.iterations.numpy())

            if j % summary_frequency == 0:
                if args.log:
                    with writer.as_default():
                        m.write_summaries(fixed_length_x, fixed_length_labels, y_hat, loss, grads, step)

                print(j, float(loss))
                # plot(y_hat.numpy(), fixed_length_labels, sample_names[0], sample_idx=np.random.randint(0, num_samples))

            if args.log:
                ckpt.write(os.path.join(log_dir, "rhythmic_grouping_rnn.ckpt"))

    except KeyboardInterrupt:
        pass

    if args.log:
        writer.flush()


def test(args):
    num_samples = 15
    time_steps = 300

    x_test, labels_test, sample_names = common(args)

    m = RNN()
    m.checkpoint().read(args.checkpoint).expect_partial()

    fixed_length_x = x_test[:num_samples, 0:time_steps, :]
    fixed_length_labels = labels_test[:num_samples, 0:time_steps]
    y_hat, loss = m.forward(fixed_length_x, fixed_length_labels)
    y_hat = y_hat.numpy()
    print("Test Loss", float(loss))

    for test_idx in range(len(fixed_length_x)):
        plt.figure()
        plt.plot(y_hat[test_idx], label="y_hat")
        plt.plot(fixed_length_labels[test_idx], label="labels")
        plt.ylabel("% likelihood of start of group")
        plt.xlabel("time")
        plt.title("Test on sample {} ({})".format(test_idx, sample_names[test_idx]))

    plt.show()


def plot(y_hat, fixed_length_labels, sample_name, sample_idx):
    plt.plot(y_hat[sample_idx], label="y_hat")
    plt.plot(fixed_length_labels[sample_idx], label="labels")
    plt.ylabel("% likelihood of start of group")
    plt.xlabel("time")
    plt.title("Test on sample " + sample_name)
    plt.show()


if __name__ == "__main__":
    main()
