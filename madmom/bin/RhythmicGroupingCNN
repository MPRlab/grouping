#!/usr/bin/env python

import argparse
import os
from datetime import datetime

import numpy as np
import tensorflow as tf


class CNN:
    def __init__(self, n_time_steps):
        num_features = 314
        conv1_channels = 32
        conv2_channels = 64
        kernel_1_size = [5, 5]
        kernel_2_size = [5, 5]
        self.kernel_2_size = kernel_2_size

        # REMEMBER: time is the first axis
        x = tf.keras.Input(shape=(n_time_steps, num_features, 1), name="x")

        self.conv1 = tf.keras.layers.Conv2D(conv1_channels, kernel_1_size, padding="same", activation="relu",
                                            name="conv1")
        pool1 = tf.keras.layers.MaxPooling2D(pool_size=[2, 2], strides=1)(self.conv1(x))

        self.conv2 = tf.keras.layers.Conv2D(conv2_channels, kernel_2_size, padding="same", activation="relu",
                                            name="conv2")
        pool2 = tf.keras.layers.MaxPooling2D(pool_size=[2, 2], strides=1)(self.conv2(pool1))

        pool2_flat = tf.keras.layers.Flatten()(pool2)
        dense1 = tf.keras.layers.Dense(1024, activation="relu", name="dense1")(pool2_flat)
        dense2 = tf.keras.layers.Dense(256, activation="relu", name="dense2")(dense1)
        dense3 = tf.keras.layers.Dense(1, activation=None, name="dense3")(dense2)

        self.model = tf.keras.Model(x, dense3, name="rhythmic_grouping_cnn")
        self.optimizer = tf.keras.optimizers.Adam(learning_rate=0.001, epsilon=1e-8)

    def forward(self, x, y, training=False):
        dense3 = self.model(x, training=training)
        y_hat = tf.squeeze(tf.nn.sigmoid(dense3, name='y_hat'), axis=1, name='squeeze')
        loss = tf.reduce_mean(tf.square(y - y_hat))
        return y_hat, loss

    @tf.function
    def train_step(self, x, y):
        with tf.GradientTape() as tape:
            y_hat, loss = self.forward(x, y, training=True)
        grads = tape.gradient(loss, self.model.trainable_variables)
        self.optimizer.apply_gradients(zip(grads, self.model.trainable_variables))
        return y_hat, loss, grads

    def checkpoint(self):
        return tf.train.Checkpoint(model=self.model, optimizer=self.optimizer)

    def write_summaries(self, x, loss, grads, step):
        image_summary("spectrogram", np.transpose(x, (0, 2, 1, 3)), step, max_outputs=3)
        conv1_kernel = self.conv1.kernel.numpy()
        image_summary("conv1 kernel", np.transpose(conv1_kernel, (3, 0, 1, 2)), step, max_outputs=3)
        conv2_kernel = self.conv2.kernel.numpy()
        image_summary("conv2 kernel",
                      np.reshape(np.transpose(conv2_kernel, (3, 2, 0, 1)), [-1] + self.kernel_2_size)[..., None],
                      step, max_outputs=3)
        tf.summary.scalar("loss", loss, step=step)
        for grad, var in zip(grads, self.model.trainable_variables):
            tf.summary.histogram(variable_name(var) + "/gradient", grad, step=step)


def image_summary(name, images, step, max_outputs):
    # TF1 rescaled float images to the full range; tf.summary.image in TF2 clips to [0, 1] instead
    images = np.asarray(images, dtype=np.float32)
    lo = images.min(axis=(1, 2, 3), keepdims=True)
    hi = images.max(axis=(1, 2, 3), keepdims=True)
    tf.summary.image(name, (images - lo) / np.maximum(hi - lo, 1e-12), step=step, max_outputs=max_outputs)


def variable_name(var):
    return getattr(var, "path", var.name)


def main():
    DEFAULT_TIME_STEPS = 15
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers()

    train_subparser = subparsers.add_parser("train")
    train_subparser.add_argument("dataset", help="dataset (npz file)")
    train_subparser.add_argument("--log", "-l", action="store_true", help="dataset (npz file)")
    train_subparser.add_argument("--epocs", "-e", type=int, help="number of epocs to train for", default=100)
    train_subparser.add_argument("--summary-frequency", "-f", type=int, help="print every  this many cycles", default=5)
    train_subparser.add_argument("--checkpoint", help="checkpoint of saved weights (ckpt file) to continue from")
    train_subparser.add_argument("--time-steps", "-t", type=int, help="number of audio sample time steps to feed in",
                                 default=DEFAULT_TIME_STEPS)
    train_subparser.set_defaults(func=train)

    test_subparser = subparsers.add_parser("test")
    test_subparser.add_argument("dataset", help="dataset (npz file)")
    test_subparser.add_argument("checkpoint", help="checkpoint of saved weights (ckpt file)")
    test_subparser.add_argument("--time-steps", "-t", type=int, help="number of audio sample time steps to feed in",
                                default=DEFAULT_TIME_STEPS)
    test_subparser.set_defaults(func=test)

    model_only_subparser = subparsers.add_parser("model_only")
    model_only_subparser.add_argument("--time_steps", "-t", type=int, help="number of time steps",
                                      default=DEFAULT_TIME_STEPS)
    model_only_subparser.add_argument("--num_samples", type=int, help="number of audio samples to use (1-15 right now")
    model_only_subparser.set_defaults(func=model_only)

    args = parser.parse_args()

    if args == argparse.Namespace():
        parser.print_usage()
    else:
        args.func(args)


def common(args):
    dataset = np.load(args.dataset)
    x = dataset["x"]
    labels = dataset["labels"]
    sample_names = dataset["sample_names"]

    return x, labels, sample_names


def model_only(args):
    m = CNN(args.time_steps)
    m.model.summary()


def train(args):
    batch_size = 2048

    # X: 408 samples x 800 time steps (audio frames) x 314 features
    x, labels, sample_names = common(args)

    m = CNN(args.time_steps)
    ckpt = m.checkpoint()

    writer = None
    log_dir = None
    if args.log:
        stamp = "{:%B_%d_%H-%M-%S}".format(datetime.now())
        log_dir = os.path.join("log_data", stamp)
        writer = tf.summary.create_file_writer(log_dir)

    if args.checkpoint:
        # the optimizer's slot variables are restored once the first train step creates them
        ckpt.read(args.checkpoint).assert_existing_objects_matched()

    np.random.seed(0)

    try:
        print("Training for {} epocs".format(args.epocs))
        inputs_per_sample = x.shape[1] - args.time_steps
        fixed_length_x = np.ndarray((inputs_per_sample * x.shape[0], args.time_steps, x.shape[2], 1), dtype=np.float32)
        fixed_length_labels = np.ndarray((inputs_per_sample * x.shape[0]), dtype=np.float32)
        for i, t0 in enumerate(range(0, inputs_per_sample)):
            s0 = i * x.shape[0]
            s1 = s0 + x.shape[0]
            t1 = t0 + args.time_steps
            fixed_length_x[s0:s1] = x[:, t0:t1, :]
            fixed_length_labels[s0:s1] = labels[:, t1]
        for j in range(args.epocs):
            batch_0 = np.random.randint(0, fixed_length_x.shape[0] - batch_size)
            batch_x = fixed_length_x[batch_0:batch_0+batch_size]
            batch_y = fixed_length_labels[batch_0:batch_0+batch_size]
            y_hat, loss, grads = m.train_step(batch_x, batch_y)
            step = int(m.optimizer.iterations.numpy())

            if j % args.summary_frequency == 0:
                if args.log:
                    with writer.as_default():
                        m.write_summaries(batch_x, loss, grads, step)

                print(m.conv1.kernel.numpy()[0, 0, 0, :])
                print(j, float(loss))

            if args.log:
                ckpt.write(os.path.join(log_dir, "rhythmic_grouping_cnn.ckpt"))

    except KeyboardInterrupt:
        pass

    if args.log:
        writer.flush()


def test(args):
    import matplotlib.pyplot as plt

    num_samples_to_plot = 4

    x_test, labels_test, sample_names = common(args)

    m = CNN(args.time_steps)
    m.checkpoint().read(args.checkpoint).expect_partial()

    y_hat_time_range = range(args.time_steps, x_test.shape[1])
    inputs_per_sample = x_test.shape[1] - args.time_steps
    sample_x = np.ndarray((inputs_per_sample, args.time_steps, x_test.shape[2], 1), dtype=np.float32)

    for sample_idx in range(num_samples_to_plot):
        # for each sample, step over each args.time_steps chunk and compute y_hat
        # we start at args.time_steps because we need that many previous frames to predict
        for i, t1 in enumerate(y_hat_time_range):
            t0 = t1 - args.time_steps
            sample_x[i] = x_test[sample_idx, t0:t1, :]

        y_hat, loss = m.forward(sample_x, labels_test[sample_idx, args.time_steps:].astype(np.float32))

        print("Test Loss", float(loss))
        plt.figure()
        plt.plot(y_hat_time_range, y_hat.numpy(), label="y_hat")
        plt.plot(labels_test[sample_idx], label="labels")
        plt.ylabel("% likelihood of start of group")
        plt.xlabel("time (audio frame @ 100fps)")
        plt.legend()
        plt.title("Test on sample {} ({})".format(sample_idx, sample_names[sample_idx]))

    plt.show()


if __name__ == "__main__":
    main()
